# One-time install on the homelab:
#   sudo cp gym-tv.service /etc/systemd/system/ && sudo systemctl daemon-reload && sudo systemctl enable --now gym-tv
# Requires Node 24+ at /usr/bin/node (adjust ExecStart if `which node` says otherwise, e.g. nvm).
[Unit]
Description=Gym TV workout player
After=network-online.target
Wants=network-online.target

[Service]
# Runs as tom by default. To run it as the web server user instead: User=www-data / Group=www-data.
User=tom
Group=www-data
# Files the app creates (database, WAL) stay group-writable for whoever deploys/backs up.
UMask=0002
WorkingDirectory=/var/www/workout
Environment=NODE_ENV=production
Environment=PORT=8787
Environment=DB_PATH=/var/www/workout/data/workout.db
Environment=OVERRIDES_DIR=/var/www/workout/data/media-overrides
ExecStart=/usr/bin/node src/server/main.ts
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
